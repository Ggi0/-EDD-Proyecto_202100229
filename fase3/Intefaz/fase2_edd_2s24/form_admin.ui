   <property name="styleSheet">
    <string notr="true">QFrame#frame {
    background-color: #E0F7FA; /* Azul claro con un toque vibrante */
    border: 2px solid #00796B; /* Borde en verde azulado para un contraste atractivo */
    border-radius: 5px; /* Bordes redondeados para suavidad */
    padding: 15px; /* Espacio interno mayor para mejor estructura */
    


    /* Agregar un degradado sutil para darle más dimensión */
    background: qlineargradient(
        spread: pad, 
        x1: 0, y1: 0, 
        x2: 1, y2: 1, 
        stop: 0 #E0F7FA, 
        stop: 1 #B2EBF2
    ); /* Degradado azul claro a un tono más fresco */
}
</string>
   </property>
   <property name="frameShape">
    <enum>QFrame::StyledPanel</enum>
   </property>
   <property name="frameShadow">
    <enum>QFrame::Raised</enum>
