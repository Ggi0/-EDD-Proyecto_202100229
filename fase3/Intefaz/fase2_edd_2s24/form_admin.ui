    <property name="styleSheet">
     <string notr="true">QPushButton#btt_buscar {
background: qlineargradient(
    spread: pad, 
    x1: 0, y1: 0, 
    x2: 1, y2: 1, 
    stop: 0 #5DADE2, /* Azul más claro */
    stop: 1 #85C1E9  /* Azul aún más claro */
); /* Degradado de azul claro a azul más claro */

    color: #FFFFFF; /* Texto blanco para buen contraste */
    border: 2px solid #3498DB; /* Borde más oscuro para definición */
    border-radius: 5px; /* Bordes redondeados para suavidad */
    padding: 10px 20px; /* Espacio interno para mejor tamaño del botón */
    font-size: 16px; /* Tamaño de fuente para legibilidad */
  
}

QPushButton#btt_buscar:hover {
    background-color: #2980B9; 
    border-color: #1F618D; 
}

QPushButton#btt_buscar:pressed {
    background-color: #2980B9; /* Color más oscuro cuando se presiona */
    border-color: #1F618D; /* Borde más oscuro cuando se presiona */
}</string>
    </property>
    <property name="text">
     <string>Buscar</string>
    </property>
   </widget>
